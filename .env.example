# Copy this file to `.env` and fill in real values (`.env` is gitignored).
# Used by the live smoke test: npm run smoke

# Your Transak partner API key (from the Partner dashboard).
TRANSAK_API_KEY=

# Your Transak API secret — keep this private, never commit it.
TRANSAK_API_SECRET=

# Environment: STAGING (default) or PRODUCTION.
TRANSAK_ENV=STAGING

# Required by the widget-URL flow (buy/sell) — your web domain or app package
# name, allow-listed in the Partner dashboard.
TRANSAK_REFERRER_DOMAIN=<YOUR_REFERRER_DOMAIN>

# The end user's IP for the mandatory `x-user-ip` header — a valid IPv4/IPv6.
TRANSAK_USER_IP=<YOUR_USER_IP>

# Optional — an existing order id, to exercise getTransactionDetail.
# TRANSAK_ORDER_ID=
